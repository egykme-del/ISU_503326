<?xml version="1.0"?>
<robot name="my_best_model" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="wheel.xacro"/>

  
  <link name="base_link">
    <visual>
      
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><box size="0.20 0.16 0.09"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  
  <xacro:wheel side="left" y="0.0925"/>
  <xacro:wheel side="right" y="-0.0925"/>

  
  <link name="arm_link_1">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.06"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  
  <joint name="arm_joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1"/>
  </joint>

  
  <link name="arm_link_2">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.06"/></geometry>
      <material name="green"/>
    </visual>
  </link>
  
  <joint name="arm_joint_2" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="5" velocity="1"/>
  </joint>

  
  <link name="arm_link_3">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.06"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  
  <joint name="arm_joint_3" type="revolute">
    <parent link="arm_link_2"/>
    <child link="arm_link_3"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="5" velocity="1"/>
  </joint>

  
  <link name="arm_link_4">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.06"/></geometry>
      <material name="green"/>
    </visual>
  </link>
  
  <joint name="arm_joint_4" type="revolute">
    <parent link="arm_link_3"/>
    <child link="arm_link_4"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="5" velocity="1"/>
  </joint>
</robot>
